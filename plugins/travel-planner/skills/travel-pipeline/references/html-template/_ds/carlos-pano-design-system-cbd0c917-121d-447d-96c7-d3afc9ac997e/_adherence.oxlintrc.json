{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/devices/**",
              "components/icon/**",
              "components/showcase/**",
              "components/social/**",
              "components/surfaces/**",
              "ui_kits/brand-sheets/**",
              "ui_kits/project-showcase/**",
              "ui_kits/social-posts/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Poppins|Urbanist))/i]",
        "message": "Font not provided by the design system. Available: Inter, Poppins, Urbanist."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:blur|tint|children|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: blur, tint, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowOrb'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|key|ref|className|style|children)$/]",
        "message": "<GlowOrb> doesn't accept that prop. Declared props: size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowOrb'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|blue|aqua|grey)$/]",
        "message": "<GlowOrb> tone must be one of 'mint' | 'blue' | 'aqua' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|color|key|ref|className|style|children)$/]",
        "message": "<LogoLockup> doesn't accept that prop. Declared props: width, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|boxed|boxColor|key|ref|className|style|children)$/]",
        "message": "<LogoMark> doesn't accept that prop. Declared props: size, color, boxed, boxColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='MacbookFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|src|alt|label|key|ref|className|style|children)$/]",
        "message": "<MacbookFrame> doesn't accept that prop. Declared props: width, src, alt, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='PatternField'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|scale|assetBase|children|key|ref|className|style|children)$/]",
        "message": "<PatternField> doesn't accept that prop. Declared props: tone, scale, assetBase, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PatternField'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|blue|mint)$/]",
        "message": "<PatternField> tone must be one of 'navy' | 'blue' | 'mint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|ground|orbs|mark|padded|children|key|ref|className|style|children)$/]",
        "message": "<PostCanvas> doesn't accept that prop. Declared props: size, ground, orbs, mark, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProPreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|backdrop|markCorner|children|key|ref|className|style|children)$/]",
        "message": "<ProPreview> doesn't accept that prop. Declared props: width, backdrop, markCorner, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProPreview'] > JSXAttribute[name.name='markCorner'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<ProPreview> markCorner must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenIPhone12Pro'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|src|alt|notch|key|ref|className|style|children)$/]",
        "message": "<ScreenIPhone12Pro> doesn't accept that prop. Declared props: width, src, alt, notch."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenshotCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|width|height|ratio|key|ref|className|style|children)$/]",
        "message": "<ScreenshotCard> doesn't accept that prop. Declared props: src, alt, width, height, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialMediaFacebook'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<SocialMediaFacebook> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialMediaInstagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<SocialMediaInstagram> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialMediaTikTok'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<SocialMediaTikTok> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialMediaTwitter'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<SocialMediaTwitter> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialMediaWhatsapp'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|key|ref|className|style|children)$/]",
        "message": "<SocialMediaWhatsapp> doesn't accept that prop. Declared props: size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwatchTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|label|hex|key|ref|className|style|children)$/]",
        "message": "<SwatchTile> doesn't accept that prop. Declared props: color, size, label, hex."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|color|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: width, color."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
